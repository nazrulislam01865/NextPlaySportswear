# Central payment gateway settings
# Keep STRIPE_ENABLED=false until BOTH the API key and webhook signing secret
# are present on the server. Never commit real keys to Git.
PAYMENT_DEFAULT_GATEWAY=stripe
PAYMENT_WEBHOOK_QUEUE=payments
PAYMENT_WEBHOOK_CLAIM_TIMEOUT_MINUTES=10
PAYMENT_RECONCILE_AFTER_MINUTES=10
PAYMENT_RECONCILE_BATCH_SIZE=100

STRIPE_ENABLED=false
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=USD
STRIPE_CHECKOUT_EXPIRES_MINUTES=30
