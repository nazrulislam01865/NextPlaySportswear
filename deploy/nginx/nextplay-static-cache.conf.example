# Include this file inside the existing Nginx `server {}` block.
# Replace /var/www/nextplay with the absolute Laravel project directory.

# Vite emits content-hashed filenames, so these assets can be cached forever.
location ^~ /build/ {
    root /var/www/nextplay/public;
    try_files $uri =404;

    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header X-Content-Type-Options "nosniff" always;

    access_log off;
    log_not_found off;
}

# Keep old application-generated media URLs working without booting Laravel.
location ~ ^/media/(.*)$ {
    return 301 /storage/$1;
}

# Uploaded/public images are served by Nginx directly, not Laravel/PHP.
# The extension allow-list preserves the old image-only exposure policy.
location ~* ^/storage/(.+\.(?:avif|webp|png|jpe?g|gif|svg))$ {
    alias /var/www/nextplay/storage/app/public/$1;
    autoindex off;

    add_header Cache-Control "public, max-age=2592000" always;
    add_header X-Content-Type-Options "nosniff" always;

    access_log off;
    log_not_found off;
}

# Do not expose arbitrary files placed on the public disk.
location /storage/ {
    return 404;
}

# Repository-owned images, icons and fonts that do not use Vite hashes.
location ~* \.(?:avif|webp|png|jpe?g|gif|svg|ico|woff2?|ttf|otf)$ {
    root /var/www/nextplay/public;
    try_files $uri =404;

    add_header Cache-Control "public, max-age=2592000" always;
    add_header X-Content-Type-Options "nosniff" always;

    access_log off;
    log_not_found off;
}
